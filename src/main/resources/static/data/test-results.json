{
  "project": "SafeSense",
  "build": "v0.1",
  "course": "ET-201",
  "team": "Team 23",
  "environment": "Java 17, Spring Boot, Chrome 126, localhost:8080",
  "note": "Sample data for demonstration",
  "bug": {
    "id": "BUG-01",
    "symptom": "Hydrogen sulfide at exactly 50.0 ppm showed Warning instead of Critical",
    "rootCause": "Threshold.classify() used > instead of >= for the critical limit",
    "fix": "Changed value > criticalLimit to value >= criticalLimit",
    "retest": "T8 passed, then T1 to T12 re-run, all pass"
  },
  "tests": [
    {
      "id": "U1",
      "category": "Unit",
      "name": "Normal gas level",
      "input": "setGasLevel(30.0)",
      "expected": "NORMAL",
      "actual": "NORMAL: Air is safe",
      "oopConcept": "Method overriding",
      "result": "PASS"
    },
    {
      "id": "U2",
      "category": "Unit",
      "name": "Critical gas level",
      "input": "setGasLevel(120.5)",
      "expected": "CRITICAL",
      "actual": "CRITICAL: Toxic gas detected",
      "oopConcept": "Method overriding",
      "result": "PASS"
    },
    {
      "id": "U3",
      "category": "Unit",
      "name": "Negative input",
      "input": "setGasLevel(-15.0)",
      "expected": "Exception handled, level 0",
